[recording]
exten => _X.,1,set(dex=$[${dex} + 1])
  same => n,GotoIf($[${dex} > 2]?tit) 
  same => n,MixMonitor(/var/spool/asterisk/monitor/${CALLFILENAME}.wav,b)
  same => n(tit),Set(UNAVAIL_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'extension_unavailable' or p.get('id') == 'extension_unavailable'), 'is-curntly-unavail') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'is-curntly-unavail', end='')"})
  same => n,Set(BUSY_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'extension_busy' or p.get('id') == 'extension_busy'), 'busy') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'busy', end='')"})
  same => n,Set(NOANS_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'no_answer' or p.get('id') == 'no_answer' or p.get('name') == 'no-answer' or p.get('id') == 'no-answer'), 'number-not-answering') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'number-not-answering', end='')"})
  
  same => n,GoToIf($["${DB(DND/${EXTEN})}" = "on" ]?dnd_handling)
  
  ; Case B: DND is off. Check device state:
  same => n,GotoIf($[ "${PJSIP_DIAL_CONTACTS(${EXTEN})}" = "" ]?check_fm_unavail_rec)
  same => n,Set(DEVSTATE=${DEVICE_STATE(PJSIP/${EXTEN})})
  same => n,GotoIf($[ "${DEVSTATE}" = "INUSE" | "${DEVSTATE}" = "BUSY" | "${DEVSTATE}" = "RINGING" | "${DEVSTATE}" = "RINGINUSE" | "${DEVSTATE}" = "ONHOLD" ]?check_fm_busy_rec)
  
  ; Available: Dial normally
  same => n,Set(RT=${IF($["${RING_${EXTEN}}"=""]?60:${RING_${EXTEN}})})
  same => n,Dial(${PJSIP_DIAL_CONTACTS(${EXTEN})},${RT},TtHh)
  same => n,FollowMe(${EXTEN},d)
  
  ; Check Dial Status post-dial:
  same => n,GotoIf($["${DIALSTATUS}" = "BUSY"]?play_busy)
  same => n,GotoIf($["${DIALSTATUS}" = "CHANUNAVAIL" | "${DIALSTATUS}" = "CONGESTION"]?play_unavail)
  same => n,GotoIf($["${DIALSTATUS}" = "NOANSWER"]?no_answer_handling)
  same => n,Hangup()
  same => n(check_fm_unavail_rec),FollowMe(${EXTEN},d)
  same => n,Goto(play_unavail)
  same => n(check_fm_busy_rec),FollowMe(${EXTEN},d)
  same => n,Goto(play_busy)

  ; DND handling
  same => n(dnd_handling),GotoIf($["${TOLOWER(${VM_${EXTEN}})}" = "on"]?vm,${EXTEN},1)
  same => n,GotoIf($[ "${PJSIP_DIAL_CONTACTS(${EXTEN})}" = "" ]?play_unavail)
  same => n,Goto(play_busy)
  
  ; Play busy recording
  same => n(play_busy),Playback(${BUSY_MSG})
  same => n,Hangup()
  
  ; Play unavailable recording
  same => n(play_unavail),Playback(${UNAVAIL_MSG})
  same => n,Hangup()
  
  ; No Answer handling
  same => n(no_answer_handling),GotoIf($["${TOLOWER(${VM_${EXTEN}})}" = "on"]?vm,${EXTEN},1)
  same => n,Goto(forward-noanswer,${EXTEN},1)



[dexter]
exten => _X.,1,Set(CALLFILENAME=${EXTEN}-${CALLERID(num)}-${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)})
  same => n,Set(UNAVAIL_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'extension_unavailable' or p.get('id') == 'extension_unavailable'), 'is-curntly-unavail') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'is-curntly-unavail', end='')"})
  same => n,Set(BUSY_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'extension_busy' or p.get('id') == 'extension_busy'), 'busy') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'busy', end='')"})
  same => n,Set(NOANS_MSG=${SHELL(python3 -c "print(next((p['path'].split('/sounds/')[-1].split('.')[0] for p in __import__('json').load(open('/etc/asterisk/rcm_media_center.json')).get('prompts', []) if p.get('name') == 'no_answer' or p.get('id') == 'no_answer' or p.get('name') == 'no-answer' or p.get('id') == 'no-answer'), 'number-not-answering') if __import__('os').path.exists('/etc/asterisk/rcm_media_center.json') else 'number-not-answering', end='')"})
 
  same => n,GoToIf($["${RECORD_${CALLERID(num)}}" = "out"]?recording,${EXTEN},1)
  same => n,GoToIf($["${RECORD_${EXTEN}}" = "out"]?recording,${EXTEN},1)
  same => n,GoToIf($["${RECORD_${EXTEN}}" = "in"]?recording,${EXTEN},1)
  same => n,GotoIf($[ "${RECORD_${CALLERID(num)}}" = "all" | "${RECORD_${EXTEN}}" = "all" ]?recording,${EXTEN},1)
  
  ; Check Forward Always
  same => n,Set(FWD_ALWAYS=${DB(FORWARD/ALWAYS/${EXTEN})})
  same => n,GotoIf($["${FWD_ALWAYS}" != ""]?forward_always)

  same => n,GoToIf($["${DB(DND/${EXTEN})}" = "on" ]?dnd_handling)
  
  ; Case B: DND is off. Check device state:
  same => n,GotoIf($[ "${PJSIP_DIAL_CONTACTS(${EXTEN})}" = "" ]?check_fm_unavail)
  same => n,Set(DEVSTATE=${DEVICE_STATE(PJSIP/${EXTEN})})
  same => n,GotoIf($[ "${DEVSTATE}" = "INUSE" | "${DEVSTATE}" = "BUSY" | "${DEVSTATE}" = "RINGING" | "${DEVSTATE}" = "RINGINUSE" | "${DEVSTATE}" = "ONHOLD" ]?check_fm_busy)
  
  ; Available: Dial normally (T/t for Transfer, X/x/W/w for automixmon/automon recording toggle *1)
  same => n,Set(RT=${IF($["${RING_${EXTEN}}"=""]?60:${RING_${EXTEN}})})
  same => n,Dial(${PJSIP_DIAL_CONTACTS(${EXTEN})},${RT},TtHhXxWw)
  same => n,FollowMe(${EXTEN},d)
  
  ; Check Dial Status post-dial:
  same => n,GotoIf($["${DIALSTATUS}" = "BUSY"]?play_busy)
  same => n,GotoIf($["${DIALSTATUS}" = "CHANUNAVAIL" | "${DIALSTATUS}" = "CONGESTION"]?goto_unavail)
  same => n,GotoIf($["${DIALSTATUS}" = "NOANSWER"]?no_answer_handling)
  same => n,Hangup()
  same => n(check_fm_unavail),FollowMe(${EXTEN},d)
  same => n,Goto(goto_unavail)
  same => n(check_fm_busy),FollowMe(${EXTEN},d)
  same => n,Goto(play_busy)
 
  ; Forward Always destination
  same => n(forward_always),Goto(from-internal-${EXTEN},${FWD_ALWAYS},1)

  ; DND handling
  same => n(dnd_handling),GotoIf($["${TOLOWER(${VM_${EXTEN}})}" = "on"]?vm,${EXTEN},1)
  same => n,GotoIf($[ "${PJSIP_DIAL_CONTACTS(${EXTEN})}" = "" ]?goto_unavail)
  same => n,Goto(play_busy)
  
  ; Play busy recording (checks Forward Busy first)
  same => n(play_busy),Set(FWD_BUSY=${DB(FORWARD/BUSY/${EXTEN})})
  same => n,GotoIf($["${FWD_BUSY}" != ""]?forward_busy)
  same => n,Playback(${BUSY_MSG})
  same => n,Hangup()

  ; Forward Busy destination
  same => n(forward_busy),Goto(from-internal-${EXTEN},${FWD_BUSY},1)
  
  ; Play unavailable recording / Check Forward/Voicemail
  same => n(goto_unavail),Goto(unavail-fallback,${EXTEN},1)
  
  ; No Answer handling
  same => n(no_answer_handling),GotoIf($["${TOLOWER(${VM_${EXTEN}})}" = "on"]?vm,${EXTEN},1)
  same => n,Goto(forward-noanswer,${EXTEN},1)



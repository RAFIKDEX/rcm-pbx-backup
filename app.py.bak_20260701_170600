@app.route('/inbound-routes/priority/<route_id>/<direction>', methods=['POST'])
def inbound_route_priority(route_id, direction):
    routes = db.get_inbound_routes()
    routes = sorted(routes, key=lambda r: int(r.get("priority", 999)))
    
    curr_idx = next((i for i, r in enumerate(routes) if r.get('id') == route_id), -1)
    if curr_idx == -1:
        flash("Route not found.", "danger")
        return redirect(url_for('inbound_routes_list'))
        
    if direction == 'up' and curr_idx > 0:
        routes[curr_idx], routes[curr_idx - 1] = routes[curr_idx - 1], routes[curr_idx]
    elif direction == 'down' and curr_idx < len(routes) - 1:
        routes[curr_idx], routes[curr_idx + 1] = routes[curr_idx + 1], routes[curr_idx]
        
    for idx, r in enumerate(routes):
        r['priority'] = idx + 1
        
    db.save_inbound_routes(routes)
    asterisk_helper.sync_inbound_routes_dialplan()
    add_pending_change("Inbound Route priorities adjusted")
    flash("Route priority updated successfully.", "success")
    return redirect(url_for('inbound_routes_list'))


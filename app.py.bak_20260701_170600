            q_data["live_status_error"] = False
        data.append(q_data)
        
    return jsonify({
        "data": data,
        "total_rows": total_rows,
        "current_page": page,
        "limit": limit
    })

# 6. CDR Logs paginated API
@app.route('/api/cdr-list')
def api_cdr_list():
    if 'logged_in' not in session:
        return jsonify({"error": "Unauthorized"}), 401
    try:
        page = int(request.args.get('page', 1))
        limit = int(request.args.get('limit', 10))
    except ValueError:
        page = 1
        limit = 10
    if limit not in [10, 30, 50, 70, 100]:
        limit = 10
        
    db.sync_cdr_records()
    
    date_from = request.args.get('date_from', '').strip()
    date_to = request.args.get('date_to', '').strip()
    extension = request.args.get('extension', '').strip()
    status = request.args.get('status', '').strip()
    search_q = request.args.get('q', '').strip()
    
    conn = db.get_db()
    cursor = conn.cursor()
    
    query_parts = []
    params = []
    
    if date_from:
        query_parts.append("start_time >= ?")
        params.append(date_from + " 00:00:00")
    if date_to:
        query_parts.append("start_time <= ?")
        params.append(date_to + " 23:59:59")
    if extension:
        query_parts.append("(src = ? OR dst = ?)")
        params.extend([extension, extension])
    if status:
        query_parts.append("status = ?")
        params.append(status)
    if search_q:
        q_wild = f"%{search_q}%"
        query_parts.append("(src LIKE ? OR dst LIKE ? OR clid LIKE ? OR uniqueid LIKE ? OR channel LIKE ? OR dstchannel LIKE ? OR lastapp LIKE ? OR lastdata LIKE ?)")
        params.extend([q_wild, q_wild, q_wild, q_wild, q_wild, q_wild, q_wild, q_wild])
        
    where_clause = " WHERE " + " AND ".join(query_parts) if query_parts else ""
    
    count_query = "SELECT COUNT(*) as count FROM cdr_records" + where_clause
    cursor.execute(count_query, params)
    total_rows = cursor.fetchone()["count"]
    
    data_query = "SELECT * FROM cdr_records" + where_clause + " ORDER BY start_time DESC LIMIT ? OFFSET ?"
    data_params = list(params)
    data_params.extend([limit, (page - 1) * limit])
    cursor.execute(data_query, data_params)
    rows = cursor.fetchall()
    conn.close()
    
    monitor_folder = "/var/spool/asterisk/monitor"
    recording_files = []
    if os.path.exists(monitor_folder):
        try:
            for f in os.listdir(monitor_folder):
                if f.endswith('.wav'):
                    fpath = os.path.join(monitor_folder, f)
                    mtime = os.path.getmtime(fpath)
                    parts = f.replace(".wav", "").split("-")
                    if len(parts) >= 2:
                        recording_files.append({
                            "filename": f,
                            "val1": parts[0],
                            "val2": parts[1],
                            "mtime": mtime
                        })
        except Exception as e:
            print(f"Error caching recordings in API: {e}")
            
    data = []
    for r in rows:
        recording = r["recording"]
        if not recording:
            try:
                epoch = int(float(r["uniqueid"]))
            except (ValueError, TypeError):
                epoch = 0
            if epoch:
                src = r["src"]
                dst = r["dst"]
                billsec = r["billsec"]
                min_diff = 99999
                for rec in recording_files:
                    if (rec["val1"] == dst and rec["val2"] == src) or (rec["val1"] == src and rec["val2"] == dst):
                        expected_end = epoch + billsec
                        diff = abs(rec["mtime"] - expected_end)
                        if diff < 15:
                            if diff < min_diff:
                                min_diff = diff
                                recording = rec["filename"]
                                
        billsec = r["billsec"]
        mins = billsec // 60
        secs = billsec % 60
        duration_str = f"{mins:02d}:{secs:02d}"
        
        data.append({
            "uniqueid": r["uniqueid"],
            "src": r["src"],
            "dst": r["dst"],
            "clid": r["clid"],
            "channel": r["channel"],
            "dstchannel": r["dstchannel"],
            "dcontext": r["dcontext"],
            "lastapp": r["lastapp"],
            "lastdata": r["lastdata"],
            "start_str": r["start_time"],
            "duration_str": duration_str,
            "status": r["status"],
            "recording": recording
        })
        
    return jsonify({
        "data": data,
        "total_rows": total_rows,
        "current_page": page,
        "limit": limit
    })



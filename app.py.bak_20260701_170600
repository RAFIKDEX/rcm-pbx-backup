@app.route('/cdr.php')
@app.route('/cdr')
def cdr_page():
    filepath = "/var/log/asterisk/cdr-csv/Master.csv"
    records = []
    tz_gmt3 = timezone(timedelta(hours=3))
    
    # Pre-cache recording files
    monitor_folder = "/var/spool/asterisk/monitor"
    recording_files = []
    if os.path.exists(monitor_folder):
        try:
            for f in os.listdir(monitor_folder):
                if f.endswith('.wav'):
                    fpath = os.path.join(monitor_folder, f)
                    mtime = os.path.getmtime(fpath)
                    parts = f.replace(".wav", "").split("-")
                    if len(parts) >= 2:
                        recording_files.append({
                            "filename": f,
                            "val1": parts[0],
                            "val2": parts[1],
                            "mtime": mtime
                        })
        except Exception as e:
            print(f"Error caching recordings: {e}")

    if os.path.exists(filepath):
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                reader = csv.reader(f)
                for row in reader:
                    if len(row) >= 15:
                        src = row[1]
                        dst = row[2]
                        dcontext = row[3]
                        clid = row[4].replace('"', '')
                        channel = row[5]
                        dstchannel = row[6]
                        lastapp = row[7]
                        lastdata = row[8]
                        start_str = row[9]
                        answer_str = row[10]
                        end_str = row[11]
                        duration = int(row[12]) if row[12].isdigit() else 0
                        billsec = int(row[13]) if row[13].isdigit() else 0
                        disposition = row[14]
                        uniqueid = row[16] if len(row) > 16 else ""
                        
                        try:
                            dt_utc = datetime.strptime(start_str, "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc)
                            start_gmt3 = dt_utc.astimezone(tz_gmt3)
                        except Exception:
                            start_gmt3 = None
                            
                        mins = billsec // 60
                        secs = billsec % 60
                        duration_str = f"{mins:02d}:{secs:02d}"
                        
                        records.append({
                            "src": src,
                            "dst": dst,
                            "clid": clid,
                            "start_time": start_gmt3,
                            "start_str": start_gmt3.strftime("%Y-%m-%d %H:%M:%S") if start_gmt3 else start_str,
                            "duration_raw": duration,
                            "billsec": billsec,
                            "duration_str": duration_str,
                            "status": disposition,
                            "uniqueid": uniqueid,
                            "channel": channel,
                            "dstchannel": dstchannel,
                            "dcontext": dcontext,
                            "lastapp": lastapp,
                            "lastdata": lastdata,
                            "recording": None
                        })
        except Exception as e:
            print(f"Error reading Master.csv: {e}")
            
    records.sort(key=lambda x: x["start_time"] if x["start_time"] else datetime.min.replace(tzinfo=timezone.utc), reverse=True)
    
    # Match recordings using cached list
    for r in records:
        try:
            epoch = int(float(r["uniqueid"]))
        except (ValueError, TypeError):
            epoch = 0
        if epoch:
            src = r["src"]
            dst = r["dst"]
            billsec = r["billsec"]
            best_match = None
            min_diff = 99999
            for rec in recording_files:
                if (rec["val1"] == dst and rec["val2"] == src) or (rec["val1"] == src and rec["val2"] == dst):
                    expected_end = epoch + billsec
                    diff = abs(rec["mtime"] - expected_end)
                    if diff < 15:
                        if diff < min_diff:
                            min_diff = diff
                            best_match = rec["filename"]
            r["recording"] = best_match

    # Filtering
    date_from = request.args.get('date_from', '').strip()
    date_to = request.args.get('date_to', '').strip()
    extension = request.args.get('extension', '').strip()
    status = request.args.get('status', '').strip()
    search_query = request.args.get('q', '').strip()
    
    filtered = []
    for r in records:
        if date_from:
            try:
                dt_from = datetime.strptime(date_from + " 00:00:00", "%Y-%m-%d %H:%M:%S").replace(tzinfo=tz_gmt3)
                if not r["start_time"] or r["start_time"] < dt_from:
                    continue
            except Exception:
                pass
        if date_to:
            try:
                dt_to = datetime.strptime(date_to + " 23:59:59", "%Y-%m-%d %H:%M:%S").replace(tzinfo=tz_gmt3)
                if not r["start_time"] or r["start_time"] > dt_to:
                    continue
            except Exception:
                pass
        if extension:
            if extension not in r["src"] and extension not in r["dst"]:
                continue
        if status:
            if r["status"] != status:
                continue
        if search_query:
            q_lower = search_query.lower()
            match = (
                q_lower in r["src"].lower() or
                q_lower in r["dst"].lower() or
                q_lower in r["clid"].lower() or
                q_lower in r["uniqueid"].lower() or
                q_lower in r["channel"].lower() or
                q_lower in r["dstchannel"].lower() or
                q_lower in r["lastapp"].lower() or
                q_lower in r["lastdata"].lower()
            )
            if not match:
                continue
        filtered.append(r)
        
    # Stats calculation for today
    now_gmt3 = datetime.now(tz_gmt3)
    today_str = now_gmt3.strftime("%Y-%m-%d")
    
    total_calls_today = 0
    total_talk_time_today = 0
    answered_calls_today = 0
    missed_calls_today = 0
    calls_by_hour = [0] * 24
    
    for r in records:
        if r["start_time"] and r["start_time"].strftime("%Y-%m-%d") == today_str:
            total_calls_today += 1
            total_talk_time_today += r["billsec"]
            hour = r["start_time"].hour
            calls_by_hour[hour] += 1
            if r["status"] == "ANSWERED":
                answered_calls_today += 1
            else:
                missed_calls_today += 1
                
    answered_ratio = 0
    missed_ratio = 0
    if total_calls_today > 0:
        answered_ratio = round((answered_calls_today / total_calls_today) * 100)
        missed_ratio = 100 - answered_ratio
        
    h = total_talk_time_today // 3600
    m = (total_talk_time_today % 3600) // 60
    s = total_talk_time_today % 60
    talk_time_today_str = f"{h}h {m}m {s}s" if h > 0 else f"{m}m {s}s"
    
    stats_today = {
        "total_calls": total_calls_today,
        "total_talk_time": talk_time_today_str,
        "answered_ratio": answered_ratio,
        "missed_ratio": missed_ratio
    }

    # CSV Export
    if request.args.get('export') == '1':
        import io
        output_io = io.StringIO()
        writer = csv.writer(output_io)
        writer.writerow(['Date & Time', 'Caller', 'Destination', 'Duration (billsec)', 'Status', 'UniqueID'])
        for r in filtered:
            writer.writerow([
                r["start_str"],
                r["src"],
                r["dst"],
                r["billsec"],
                r["status"],
                r["uniqueid"]
            ])
        output_io.seek(0)
        return Response(
            output_io.getvalue(),
            mimetype="text/csv",
            headers={"Content-disposition": "attachment; filename=cdr_filtered_export.csv"}
        )

    # Pagination
    try:
        per_page = int(request.args.get('per_page', 10))
    except ValueError:
        per_page = 10
    if per_page not in [10, 30, 50, 70, 100]:
        per_page = 10
        
    try:
        page = int(request.args.get('page', 1))
    except ValueError:
        page = 1
        
    total_filtered = len(filtered)
    total_pages = max(1, (total_filtered + per_page - 1) // per_page)
    page = min(max(1, page), total_pages)
    offset = (page - 1) * per_page
    paginated_records = filtered[offset : offset + per_page]
    
    if request.args.get('ajax') == '1':
        return render_template('cdr_table_partial.html', 
                               records=paginated_records, 
                               total_filtered=total_filtered, 
                               page=page, 
                               total_pages=total_pages,
                               per_page=per_page,
                               stats=stats_today,
                               calls_by_hour=calls_by_hour)
                               
    return render_template('cdr.html', 
                           records=paginated_records, 
                           total_filtered=total_filtered, 
                           page=page, 
                           total_pages=total_pages,
                           per_page=per_page,
                           stats=stats_today,
                           calls_by_hour=calls_by_hour)


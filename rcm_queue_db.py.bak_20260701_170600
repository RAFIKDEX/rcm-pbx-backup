            c.execute("""
                SELECT event_type, timestamp FROM queue_agent_events 
                WHERE queue = ? AND agent = ? AND event_type IN ('LOGIN', 'LOGOUT', 'PAUSE', 'UNPAUSE') 
                  AND timestamp < ? 
                ORDER BY timestamp DESC LIMIT 1
            """, (qnum, ag, filters["date_from"] + " 00:00:00"))

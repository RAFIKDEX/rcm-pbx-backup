            """, (agent_ext, queuename))
            
            c.execute("SELECT COUNT(*) FROM queue_agent_events WHERE agent = ? AND queue = ? AND event_type = 'PAUSE' AND timestamp = ?", (agent_ext, queuename, dt_str))
            if c.fetchone()[0] == 0:
                c.execute("""
